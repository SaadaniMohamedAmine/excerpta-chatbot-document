# .env.example

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The canonical URL of the deployed app (or http://localhost:3000 in dev)
BETTER_AUTH_URL=http://localhost:3000
# Same value, exposed to the client for the auth client's baseURL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OAuth providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- LLM (dual-AI orchestrator) ---
GROQ_API_KEY=
# llama-3.3-70b-versatile was decommissioned 2026-08-16; openai/gpt-oss-120b is Groq's replacement
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# gemini-1.5-flash was shut down; gemini-3.7-flash is the current model
GEMINI_CHAT_MODEL=gemini-3.7-flash

# --- Vector DB (Upstash Vector) ---
# Create the index with "Custom" model / bring-your-own-embeddings, dimension
# 768, metric COSINE (matches lib/ai/gemini.ts's EMBEDDING_OUTPUT_DIMENSIONALITY)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=
